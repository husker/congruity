# Copy this file to .env (which is git-ignored) and fill in the values you want
# the project to use. The compose CLI loads .env at startup via pipeline/env.py;
# anything you `export` in your shell still wins over the file.
#
# Auth for the corpus-quality gate's relevance backend (pick whichever you have):

# Anthropic API key — enables --relevance-mode anthropic (Claude Haiku LLM-judge)
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API key — enables --relevance-mode openai (text-embedding-3-small cosine)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Voyage AI key — currently unused; reserved for a future voyage-3 embedding backend
# VOYAGE_API_KEY=

# Note: the codex CLI backend (--relevance-mode codex) needs no API key here —
# it uses whatever auth `codex` itself has locally configured.

# OpenAlex polite-pool contact email — optional but recommended (faster rate limits)
# https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_MAILTO=

# Pipeline tuning (optional)
# Parallel codex calls for scoring/verification fan-out (default 4; 1 = serial)
# CONGRUITY_MAX_CONCURRENCY=4
# Per-stage reasoning effort overrides (minimal|low|medium|high), e.g.:
# CONGRUITY_EFFORT_VERIFY_L1=medium
# CONGRUITY_EFFORT_VERIFY_L4=medium
# CONGRUITY_EFFORT_SCORING=high

# OpenAlex free API key — rides through anonymous-search throttling
# https://openalex.org/rest-api
OPENALEX_API_KEY=
